                      "data": {
                        "prompt": "观察 (x²-1)/(x-1) 在 x→1 时的行为。",
                        "steps": [
                          "因式分解 x²-1=(x-1)(x+1)",
                          "在 x≠1 的邻域中化简为 x+1",
                          "因此趋近值为 2"
                        ]
                      },
                      "id": "limit-example",
                      "kind": "worked_example"
                    }
                  ],
                  "id": "limit-example-segment",
                  "title": "用一个可消去间断点观察极限"
                }
              ],
              "summary": "从趋近过程理解极限，而不是把它当成代入规则。",
