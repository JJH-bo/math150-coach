                },
                {
                  "blocks": [
                    {
                      "data": {
                        "prompt": "观察 (x²-1)/(x-1) 在 x→1 时的行为。",
                        "steps": [
                          "因式分解 x²-1=(x-1)(x+1)",
                          "在 x≠1 的邻域中化简为 x+1",
                          "因此趋近值为 2"
                        ]
