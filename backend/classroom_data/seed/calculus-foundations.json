                },
                {
                  "data": {
                    "explanation": "当 x 足够接近 a 时，f(x) 可以任意接近 L。",
                    "latex": "\\lim_{x\\to a}f(x)=L"
                  },
                  "id": "limit-formula",
                  "kind": "formula_explanation"
                }
              ],
              "id": "limit-core",
              "segments": [
